# ==============================================================================
# Production Environment Variables Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env before starting your production application.
# 2. Fill in the values below with your verified production secrets.
# 3. NEVER commit the actual .env file or credentials to source control.
# 4. NEVER paste raw passwords or private keys directly into TypeScript/JavaScript files.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Server Port (Defaults to 3000)
PORT=3000

# Canonical Application URL
# Used for CORS validation, redirect targets, and email notifications.
# Example: https://hanzlawebstudio.com or https://ais-pre-vlvxo52sckjvpruwivugsy-708723400392.asia-southeast1.run.app
APP_URL=https://your-domain.com

# Additional CORS Allowed Origins (optional comma-separated list of origins)
# Example: https://admin.your-domain.com,https://your-domain.com
CORS_ORIGIN=https://your-domain.com

# ==============================================================================
# Database Configuration (PostgreSQL / Prisma ORM)
# ==============================================================================
# Encrypted PostgreSQL connection string for Prisma.
# Parameterized queries prevent SQL injection automatically.
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public&sslmode=prefer
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/hanzla_studio?schema=public

# ==============================================================================
# Administrative Authentication & Security
# ==============================================================================
# Authorized studio administrator email
ADMIN_EMAIL=hanzlanathiyal@gmail.com

# Bcrypt Password Hash for the Administrative Portal.
# IMPORTANT: Store ONLY the bcrypt-hashed password, NEVER the plaintext password.
# Generate with: node -e "require('bcryptjs').hash('YourStrongPassword', 12).then(console.log)"
# Example placeholder format: $2b$12$e8xL... (bcrypt 60-character string)
ADMIN_PASSWORD_HASH=$2b$12$EXAMPLE_BCRYPT_HASH_REPLACE_WITH_YOUR_OWN_HASH

# Plaintext admin password alternative (OPTIONAL - only if ADMIN_PASSWORD_HASH is not set).
# If provided, the server will compute a bcrypt hash at startup in memory.
# ADMIN_PASSWORD=

# JSON Web Token Secret Key for signing and verifying admin sessions.
# Must be a cryptographically secure random string (minimum 32 bytes).
# Generate with: openssl rand -hex 32
JWT_SECRET=your_cryptographically_secure_jwt_secret_at_least_32_chars_long

# ==============================================================================
# AI & External Integrations
# ==============================================================================
# Gemini API Key (Server-Side Only - never exposed to frontend bundles)
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# Email Notification Provider (Optional)
# ==============================================================================
# Triggers an email alert when a client submits the contact inquiry form.
# Contact submissions are ALWAYS stored in the database, even if email is unconfigured.
# If no email provider is configured, leave these empty (DO NOT invent fake credentials).
# Supports Resend API (default) or any REST delivery provider via EMAIL_API_ENDPOINT.
EMAIL_API_KEY=
EMAIL_FROM=notifications@your-domain.com
EMAIL_TO=hanzlanathiyal@gmail.com
EMAIL_API_ENDPOINT=https://api.resend.com/emails
